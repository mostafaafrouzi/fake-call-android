    <!-- About -->
    <string name="about_title">About Fake Call</string>
    <string name="about_app_desc">Fake Call schedules a realistic incoming call with a caller name, number and photo that you choose, exactly when you need it — a polite way out of meetings and awkward situations. Everything runs fully offline on your own device; no account, no internet, no tracking.</string>
    <string name="about_ownership_title">Built on modern Android</string>
    <string name="about_ownership_desc">Fake Call is a native Android app built with Kotlin and Jetpack Compose on a modern, maintainable architecture. Precise scheduling uses exact alarms with a full-screen incoming-call experience, so the call rings on time even when the app is closed or the phone is locked.</string>
    <string name="developer_title">Developer</string>
    <string name="developer_name">Mostafa Afrouzi</string>
    <string name="developer_headline">Android Developer</string>
    <string name="developer_bio">Independent Android developer building small, honest, privacy-friendly apps. Every app is open source and works fully offline wherever possible.</string>
