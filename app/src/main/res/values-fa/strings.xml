    <!-- About -->
    <string name="about_title">درباره تماس ساختگی</string>
    <string name="about_app_desc">تماس ساختگی یک تماس ورودی واقع‌گرایانه را با نام، شماره و عکس دلخواه شما، دقیقاً در زمانی که لازم دارید زمان‌بندی می‌کند؛ راهی مؤدبانه برای خروج از جلسه‌ها و موقعیت‌های ناخوشایند. همه‌چیز کاملاً آفلاین و روی گوشی خودتان اجرا می‌شود؛ بدون حساب کاربری، بدون اینترنت و بدون هیچ ردیابی.</string>
    <string name="about_ownership_title">ساخته‌شده با اندروید مدرن</string>
    <string name="about_ownership_desc">تماس ساختگی یک برنامه بومی اندروید است که با کاتلین و جت‌پک کامپوز و معماری مدرن و قابل نگه‌داری ساخته شده است. زمان‌بندی دقیق با آلارم دقیق و نمایش تمام‌صفحه تماس ورودی انجام می‌شود تا تماس سر وقت زنگ بخورد، حتی وقتی برنامه بسته است یا گوشی قفل است.</string>
    <string name="developer_title">توسعه‌دهنده</string>
    <string name="developer_name">مصطفی افروزی</string>
    <string name="developer_headline">توسعه‌دهنده اندروید</string>
    <string name="developer_bio">توسعه‌دهنده مستقل اندروید؛ سازنده برنامه‌های کوچک، صادقانه و حریم‌خصوصی‌محور. همه برنامه‌ها متن‌باز هستند و تا حد امکان کاملاً آفلاین کار می‌کنند.</string>
    <string name="link_myket">صفحهٔ توسعه‌دهنده در مایکت</string>
    <string name="link_bazaar">صفحهٔ توسعه‌دهنده در کافه‌بازار</string>
    <string name="link_repo">کد منبع این برنامه در گیت‌هاب</string>
